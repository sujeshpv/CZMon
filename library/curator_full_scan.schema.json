{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "curator_full_scan.schema.json",
  "title": "curator_full_scan",
  "description": "Curator Full Scan status collected from one PE cluster, stored in curator_full_scan.output_json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_name", "parser", "endpoint_type", "cluster_id", "cluster_name",
    "cluster_ip", "cluster_vip", "collection_status", "command_execution_status",
    "full_scan_available", "collected_at", "command", "curator_master",
    "full_scan", "errors", "warnings", "command_result"
  ],
  "properties": {
    "metric_name": {"const": "curator_full_scan"},
    "parser": {"const": "curator_full_scan"},
    "endpoint_type": {"const": "PE"},
    "cluster_id": {"type": ["string", "null"]},
    "cluster_name": {"type": ["string", "null"]},
    "cluster_ip": {"type": "string", "minLength": 1},
    "cluster_vip": {"type": ["string", "null"]},
    "collection_status": {"enum": ["success", "unavailable", "failed"]},
    "command_execution_status": {
      "enum": ["completed", "failed", "timed_out", "not_executed"]
    },
    "full_scan_available": {"type": "boolean"},
    "collected_at": {"type": "string", "format": "date-time"},
    "command": {"type": "string", "minLength": 1},
    "curator_master": {"type": ["string", "null"]},
    "full_scan": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/definitions/full_scan"}
      ]
    },
    "errors": {"type": "array", "items": {"$ref": "#/definitions/issue"}},
    "warnings": {"type": "array", "items": {"$ref": "#/definitions/issue"}},
    "command_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "stderr", "raw_output"],
      "properties": {
        "exit_code": {"type": ["integer", "null"]},
        "stderr": {"type": "string"},
        "raw_output": {"type": "string"}
      }
    }
  },
  "if": {"properties": {"collection_status": {"const": "success"}}},
  "then": {
    "properties": {
      "command_execution_status": {"const": "completed"},
      "full_scan_available": {"const": true},
      "full_scan": {
        "allOf": [
          {"$ref": "#/definitions/full_scan"},
          {
            "properties": {
              "job_name": {"const": "Full Scan"},
              "status": {"const": "Succeeded"},
              "execution_id": {"type": "integer", "minimum": 0}
            }
          }
        ]
      },
      "errors": {"maxItems": 0},
      "command_result": {"properties": {"exit_code": {"const": 0}}}
    }
  },
  "else": {"properties": {"errors": {"minItems": 1}}},
  "definitions": {
    "nullable_string": {"type": ["string", "null"]},
    "nullable_integer": {"type": ["integer", "null"]},
    "full_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_name", "job_id", "execution_id", "master_handle",
        "incarnation_id", "status_raw", "status", "start_time_raw",
        "end_time_raw", "start_time", "end_time", "timestamp_timezone"
      ],
      "properties": {
        "job_name": {"$ref": "#/definitions/nullable_string"},
        "job_id": {"$ref": "#/definitions/nullable_integer"},
        "execution_id": {"$ref": "#/definitions/nullable_integer"},
        "master_handle": {"$ref": "#/definitions/nullable_string"},
        "incarnation_id": {"$ref": "#/definitions/nullable_integer"},
        "status_raw": {"$ref": "#/definitions/nullable_string"},
        "status": {"$ref": "#/definitions/nullable_string"},
        "start_time_raw": {"$ref": "#/definitions/nullable_string"},
        "end_time_raw": {"$ref": "#/definitions/nullable_string"},
        "start_time": {"type": ["string", "null"], "format": "date-time"},
        "end_time": {"type": ["string", "null"], "format": "date-time"},
        "timestamp_timezone": {"$ref": "#/definitions/nullable_string"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "action"],
      "properties": {
        "code": {
          "enum": [
            "TARGET_UNREACHABLE", "SSH_EXECUTION_FAILED", "COMMAND_TIMEOUT",
            "COMMAND_FAILED", "NO_CURATOR_MASTER", "SCAN_STAT_PROTO_NOT_FOUND",
            "EMPTY_OUTPUT", "MALFORMED_OUTPUT", "FULL_SCAN_NOT_FOUND",
            "FULL_SCAN_NOT_SUCCEEDED", "TIMEZONE_UNKNOWN",
            "CLUSTER_ID_UNRESOLVED"
          ]
        },
        "message": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}
      }
    }
  }
}
